# Block a push whose commits mention a name from local-cvs/.private-names (see scripts/privacy-check.sh).
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
zero=0000000000000000000000000000000000000000
root="$(git rev-parse --show-toplevel)"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" != "$zero" ] || continue # deleting a ref
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # New remote branch: the commits not already on master.
    base=origin/master
    git rev-parse -q --verify "$base" >/dev/null || base=master
    bash "$root/scripts/privacy-check.sh" "$local_sha" --not "$base" || status=1
  else
    bash "$root/scripts/privacy-check.sh" "$remote_sha..$local_sha" || status=1
  fi
done
exit $status
