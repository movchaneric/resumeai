{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "mkdir -p logs && tsx watch src/index.ts 2>&1 | tee logs/dev.log",
    "build": "prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "tsx test/make-fixtures.ts",
    "extract": "tsx test/extract.ts",
    "stability": "tsx test/stability.ts",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "^4.1.4",
    "@arizeai/openinference-semantic-conventions": "^2.14.0",
    "@langchain/core": "1.2.18",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@langchain/openai": "1.6.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@resume-ai/shared": "workspace:*",
    "@types/pdfkit": "^0.17.7",
    "docx": "^9.14.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "unpdf": "^1.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
