{
  "info": {
    "name": "Resume AI - slice 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "File paths are relative to the repo root: set Postman's working directory to it (newman: --working-dir .). Fixtures are generated by `pnpm --filter backend fixtures`."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Upload PDF (happy path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 with an id', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().id).to.be.a('string'); pm.collectionVariables.set('runId', pm.response.json().id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "cv",
              "type": "file",
              "src": "backend/test/fixtures/cv.pdf"
            },
            {
              "key": "jobDescription",
              "value": "We are hiring a backend developer with Node.js and PostgreSQL experience.",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/runs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "runs"
          ]
        }
      }
    },
    {
      "name": "Get run",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('RunView is extracting with parse done', () => { pm.response.to.have.status(200); const v = pm.response.json(); pm.expect(v.status).to.eql('extracting'); pm.expect(v.steps.find(s => s.key === 'parse').state).to.eql('done'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/runs/{{runId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "runs",
            "{{runId}}"
          ]
        }
      }
    },
    {
      "name": "Get run (scored)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('RunView is scored or failed', () => { pm.response.to.have.status(200); const v = pm.response.json(); console.log('status', v.status, 'steps', JSON.stringify(v.steps), 'job', JSON.stringify(v.job), 'error', JSON.stringify(v.error)); pm.expect(['scored', 'failed'], 'pipeline still running: send again').to.include(v.status); if (v.status === 'scored') { pm.expect(v.score).to.be.a('number'); pm.expect(v.requirements).to.be.an('array').that.is.not.empty; } });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "description": "Manual check, needs the model reachable (see backend/.env). The pipeline (extraction, then Coverage) runs in the background after the upload, so this may need re-sending until `status` is `scored` or `failed`. When `scored`, `score` is a number and `requirements` lists each Requirement with its verdict and Evidence; when `failed`, `error` holds the code.",
        "url": {
          "raw": "{{baseUrl}}/runs/{{runId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "runs",
            "{{runId}}"
          ]
        }
      }
    },
    {
      "name": "Upload DOCX (happy path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "cv",
              "type": "file",
              "src": "backend/test/fixtures/cv.docx"
