# LLM. For now we use a local model through Ollama (no tokens, nothing leaves the machine).
# Ollama ignores the key but the OpenAI SDK requires one, so any value works.
# Pull the model first: ollama pull qwen3:14b
# At the end of the project we pivot to a hosted model (OpenAI, Anthropic or Gemini): set a real key and drop the base URL.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

DATABASE_URL=postgresql://resume:resume@localhost:15432/resume_ai

PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=resume-ai

PORT=3000
RUN_TTL_DAYS=7
