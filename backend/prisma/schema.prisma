generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// Run metadata only (ADR 0003). The Run's data (texts, CV, Job Profile, Coverage, Changes) lives in the LangGraph
// checkpoint, in the separate `checkpoints` schema (ADR 0005), which Prisma does not manage.
model Run {
  id           String   @id @db.Uuid
  status       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  exportPath   String?  @map("export_path")
  errorCode    String?  @map("error_code")
  errorMessage String?  @map("error_message")

  @@map("runs")
  @@schema("app")
}

// A Job Profile cached per Job Description (ADR 0007). The key is a hash, so the raw Job Description text is never stored.
model JobProfile {
  key       String   @id
  profile   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("job_profiles")
  @@schema("app")
}
