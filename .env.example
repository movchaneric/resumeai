# LLM: OpenAI by default. Put the real key only in backend/.env, never here.
OPENAI_API_KEY=
# Judge work (Coverage, the tailor and the claim check) is judgement and needs the stronger model; extraction is checked by code
LLM_MODEL=gpt-4.1-mini
LLM_JUDGE_MODEL=gpt-4.1
LLM_CONTEXT_TOKENS=128000
LLM_TIMEOUT_MS=60000
# for gpt-6-luna; leave unset for gpt-4o-mini and gpt-4.1-*
# LLM_REASONING_EFFORT=none

# Local Ollama instead (no tokens, nothing leaves the machine): comment out the OpenAI block above and use this one.
# Pull the model first: ollama pull qwen3:14b
# Ollama ignores the key but the OpenAI SDK requires one, so any value works.
# With Ollama, upload one CV at a time; a second concurrent Run may time out.
# OPENAI_BASE_URL=http://localhost:11434/v1/
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen3:14b
# LLM_JUDGE_MODEL is left unset here: judge work (Coverage) then uses LLM_MODEL.
# LLM_CONTEXT_TOKENS=16384   # must match OLLAMA_CONTEXT_LENGTH below; the backend refuses prompts that would not fit
# LLM_TIMEOUT_MS=180000
# LLM_REASONING_EFFORT=none

# Start Ollama like this (a plain `ollama serve` defaults to a 4096-token context and silently truncates long CVs):
#   OLLAMA_CONTEXT_LENGTH=16384 OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 ollama serve
# OLLAMA_CONTEXT_LENGTH: context window in tokens; keep equal to LLM_CONTEXT_TOKENS.
# OLLAMA_FLASH_ATTENTION=1: lowers memory use of long contexts and is required for the quantized KV cache.
# OLLAMA_KV_CACHE_TYPE=q8_0: stores the KV cache at 8 bits, roughly halving its memory with little quality loss.

# Any OpenAI-compatible provider works through OPENAI_BASE_URL. Gemini free tier, for example (comment out the OpenAI block above):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=   # an AI Studio key; put it only in backend/.env, never here
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_JUDGE_MODEL=gemini-3.5-flash-lite
# Larger flash models often return 503 on the free tier; scores are not comparable with the gpt-4.1 numbers.

DATABASE_URL=postgresql://resume:resume@localhost:15432/resume_ai

PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=resume-ai
# Record prompts, CV text and replies in traces. Local only: refused when NODE_ENV=production (see docs/adr/0006).
TRACE_CONTENT=true

PORT=3000
RUN_TTL_DAYS=7
# How often the TTL sweep deletes expired Runs, cached Job Profiles and orphaned checkpoints (default 3600000 = 1 hour).
SWEEP_INTERVAL_MS=3600000
